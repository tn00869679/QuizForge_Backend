# Database connection string
DATABASE_URL=postgres://quizforge:quizforge@localhost:5433/quizforge?sslmode=disable

# HTTP server port
PORT=8080

# Admin API token (change in production)
ADMIN_TOKEN=dev-admin-token

# HMAC secret for exam tokens (change in production)
EXAM_HMAC_SECRET=dev-secret

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173
